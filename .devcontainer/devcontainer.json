{
  "name": "Personal Data Agent (Flutter)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter",
        "dart.previewFlutterUiGuides": true
      }
    }
  },
  "postCreateCommand": "flutter --version && flutter pub get",
  "forwardPorts": [],
  "remoteUser": "vscode"
}
